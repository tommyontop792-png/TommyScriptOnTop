local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lut = {}
for i = 1, 64 do lut[chars:byte(i)] = i - 1 end
lut[61] = 0 -- "="

local function decode(s)
	s = s:gsub("%s", "")
	local pad = (s:sub(-2) == "==") and 2 or (s:sub(-1) == "=") and 1 or 0
	local out = {}
	for i = 1, #s, 4 do
		local a, b, c, d = s:byte(i, i + 3)
		local v = lut[a] * 262144 + lut[b] * 4096 + lut[c] * 64 + lut[d]
		out[#out + 1] = string.char(math.floor(v / 65536) % 256, math.floor(v / 256) % 256, v % 256)
	end
	local r = table.concat(out)
	return r:sub(1, #r - pad)
end

