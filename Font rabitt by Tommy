-- Guarda la fuente original de cada objeto para poder respetar iconos y emojis
local originals = setmetatable({}, {__mode = "k"})
local connected = setmetatable({}, {__mode = "k"})

-- Fuentes de iconos de Roblox (BuilderIcons, etc.)
local function isIconFont(f)
	local ok, fam = pcall(function() return tostring(f.Family):lower() end)
	return ok and (fam:find("icon") ~= nil)
end

-- Texto con glifos de iconos (zona privada) o emojis/simbolos
local function isIconText(t)
	if t == "" then return false end
	local ok = pcall(function()
		for _, cp in utf8.codes(t) do
			if (cp >= 0xE000 and cp <= 0xF8FF)      -- iconos de Roblox (Private Use)
				or cp >= 0x1F000                    -- emojis
				or (cp >= 0x2190 and cp <= 0x21FF)  -- flechas
				or (cp >= 0x2300 and cp <= 0x23FF)
				or (cp >= 0x2600 and cp <= 0x27BF)  -- simbolos / dingbats
				or (cp >= 0x2B00 and cp <= 0x2BFF)
				or cp == 0x200D or cp == 0xFE0F or cp == 0x20E3 then
				error("icon")
			end
		end
	end)
	return not ok
end

local function update(obj)
	pcall(function()
		local orig = originals[obj]
		if not orig then
			orig = obj.FontFace
			originals[obj] = orig
		end
		if isIconFont(orig) or isIconText(obj.Text) then
			obj.FontFace = orig        -- icono/emoji: se deja como estaba
		else
			obj.FontFace = font
		end
	end)
end

local function apply(obj)
	if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
		update(obj)
		if not connected[obj] then
			connected[obj] = obj:GetPropertyChangedSignal("Text"):Connect(function() update(obj) end)
		end
	end
end

local function hook(root)
	for _, v in ipairs(root:GetDescendants()) do apply(v) end
	root.DescendantAdded:Connect(apply)
end

